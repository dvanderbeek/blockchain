<%= form_with(model: transaction, class: "max-w-md mx-auto p-6 bg-white rounded-xl shadow-md space-y-6") do |form| %>
  <% if transaction.errors.any? %>
    <div class="bg-red-100 text-red-800 p-4 rounded-md border border-red-300">
      <h2 class="font-semibold mb-2">
        <%= pluralize(transaction.errors.count, "error") %> prohibited this transaction from being saved:
      </h2>
      <ul class="list-disc list-inside text-sm">
        <% transaction.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :protocol, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :protocol, value: 'solana', class: "w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 mb-2" %>
  </div>

  <div>
    <%= form.label :network, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :network, value: 'devnet', class: "w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 mb-2" %>
  </div>

  <div>
    <%= form.label :tx_hash, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :tx_hash, autofocus: true, class: "w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 mb-2" %>
  </div>

  <div>
    <%= form.label :sender_address, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :sender_address, class: "w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 mb-2" %>
  </div>

  <div>
    <%= form.submit "Save Transaction", class: "w-full bg-blue-600 text-white font-semibold py-2 px-4 rounded-md hover:bg-blue-700 transition duration-200" %>
  </div>
<% end %>
