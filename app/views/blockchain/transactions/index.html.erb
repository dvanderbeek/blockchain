<% content_for :title, "Transactions" %>

<% if notice.present? %>
  <p class="mb-4 text-green-700 bg-green-100 border border-green-300 rounded-md p-3">
    <%= notice %>
  </p>
<% end %>

<h1 class="text-2xl font-bold mb-6">Transactions</h1>

<div class="mb-6">
  <%= link_to "New transaction", new_transaction_path, class: "inline-block bg-blue-600 text-white font-medium px-4 py-2 rounded-md hover:bg-blue-700 transition" %>
</div>

<div id="transactions" class="space-y-6">
  <%= render @transactions %>
</div>
