<div id="<%= dom_id transaction %>" class="bg-white shadow-lg rounded-xl p-6 border border-gray-100 hover:shadow-xl transition-shadow duration-200">
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between">
    <!-- Transaction Info -->
    <div class="flex-1 space-y-3">
      <!-- Protocol and Network Row -->
      <div class="flex flex-wrap items-center gap-4">
        <div class="flex items-center">
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
            <%= transaction.protocol.capitalize %>
          </span>
        </div>
        <div class="flex items-center">
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
            <%= transaction.network %>
          </span>
        </div>
        <div class="flex items-center">
          <% status_class = case transaction.onchain_tx.status.to_s
             when 'confirmed'
               'bg-green-100 text-green-800'
             when 'pending'
               'bg-yellow-100 text-yellow-800'
             when 'failed'
               'bg-red-100 text-red-800'
             else
               'bg-gray-100 text-gray-800'
             end %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= status_class %>">
            <%= transaction.onchain_tx.status %>
          </span>
        </div>
      </div>

      <!-- Transaction Hash -->
      <div>
        <p class="text-sm font-medium text-gray-700 mb-1">Transaction Hash</p>
        <div class="flex items-center space-x-2">
          <code class="text-sm font-mono text-gray-900 bg-gray-50 px-3 py-2 rounded-lg break-all flex-1">
            <%= transaction.tx_hash %>
          </code>
          <button class="text-gray-400 hover:text-gray-600 transition-colors"
                  onclick="navigator.clipboard.writeText('<%= transaction.tx_hash %>')"
                  title="Copy to clipboard">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="mt-4 lg:mt-0 lg:ml-6 flex items-center space-x-2">
      <%= link_to transaction,
          class: "inline-flex items-center px-3 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors" do %>
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
        </svg>
        View
      <% end %>

      <%= link_to edit_transaction_path(transaction),
          class: "inline-flex items-center px-3 py-2 bg-gray-600 text-white text-sm font-medium rounded-lg hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 transition-colors" do %>
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
        </svg>
        Edit
      <% end %>
    </div>
  </div>
</div>
